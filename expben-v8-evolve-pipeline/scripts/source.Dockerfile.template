# syntax=docker/dockerfile:1
#
# Build a *source* image — the per-problem sec-bmk image
# (`<registry>/cybergen_v8_cr_<sha12>:<tag>`), i.e. the image an evolve
# direction starts from.
#
# This replaces the cybergen dependency: cybergen's `new -> build -> publish`
# produced exactly this artefact.  The two things it added over the evolve
# pipeline are (1) building BOTH sides of /rlenv/binaries — vulnerable at
# `<fix>^`, fixed at `<fix>` — and (2) deriving the problem metadata; both are
# done here.
#
# Multi-stage on purpose: each side needs the ~3.5 GiB build toolchain, and a
# `rm -rf` in a later layer does not remove it from the image.  Only the final
# stage's COPY results ship.
#
# Generated by scripts/prepare_source_context.py -- edit that, not this.

# --- side 1: the FIXED tree, at <fix> --------------------------------------
FROM --platform=linux/amd64 {donor} AS b_fixed
USER root
WORKDIR /
ADD build-inputs/source-deps.tar /rlenv/source/v8/
ADD src/fixed.tar /rlenv/source/v8/
COPY scripts/rjob_compile_d8.sh /tmp/b/rjob_compile_d8.sh
COPY build-inputs/gn /tmp/b/gn
COPY build-inputs/gn-args/ /tmp/b/gn-args/
RUN set -eux; \
    chmod 0755 /tmp/b/gn /tmp/b/rjob_compile_d8.sh; \
    PHASE2_BINARY_SIDE=fixed PHASE2_BUILD_CONFIGS="{configs}" \
    PHASE2_BUILD_JOBS={build_jobs} \
    PATH=/tmp/b:$PATH /tmp/b/rjob_compile_d8.sh

# --- side 2: the VULNERABLE tree, at <fix>^ ---------------------------------
# Built last so the tree left behind is the shipped one; pruned after the build
# so the final COPY carries ~0.8 GiB, not ~31 GiB.
FROM --platform=linux/amd64 {donor} AS b_vuln
USER root
WORKDIR /
ADD build-inputs/source-deps.tar /rlenv/source/v8/
ADD src/vuln.tar /rlenv/source/v8/
COPY scripts/rjob_compile_d8.sh /tmp/b/rjob_compile_d8.sh
COPY build-inputs/gn /tmp/b/gn
COPY build-inputs/gn-args/ /tmp/b/gn-args/
RUN set -eux; \
    chmod 0755 /tmp/b/gn /tmp/b/rjob_compile_d8.sh; \
    PHASE2_BINARY_SIDE=vuln PHASE2_BUILD_CONFIGS="{configs}" \
    PHASE2_BUILD_JOBS={build_jobs} \
    PATH=/tmp/b:$PATH /tmp/b/rjob_compile_d8.sh
RUN set -eux; \
    rm -rf /rlenv/source/v8/out \
           /rlenv/source/v8/build \
           /rlenv/source/v8/buildtools \
           /rlenv/source/v8/third_party/llvm-build \
           /rlenv/source/v8/third_party/rust-toolchain \
           /rlenv/source/v8/third_party/siso \
           /rlenv/source/v8/third_party/depot_tools \
           /rlenv/source/v8/gni \
           /rlenv/source/v8/test \
           /rlenv/source/v8/tools/clang \
           /rlenv/source/v8/tools/rust \
           /rlenv/source/v8/tools/protoc_wrapper \
           /rlenv/source/v8/.git

# --- final: the donor's format + the freshly built payload ------------------
FROM --platform=linux/amd64 {donor} AS final
USER root
RUN set -eux; \
    rm -rf /rlenv/binaries/vuln /rlenv/binaries/fixed /rlenv/source/v8 \
           /rlenv/problem /rlenv/cybergen \
           /testbed/problem /testbed/source /testbed/grader \
           /testbed/patch.diff /testbed/README.md /testbed/.eval-fallback.sh; \
    install -d -o 0 -g 0 -m 0755 /rlenv/binaries/vuln /rlenv/binaries/fixed; \
    install -d -o 1000 -g 1000 -m 0755 /rlenv/source/v8

COPY --chown=0:0       --from=b_fixed /rlenv/binaries/fixed/ /rlenv/binaries/fixed/
COPY --chown=0:0       --from=b_vuln  /rlenv/binaries/vuln/  /rlenv/binaries/vuln/
COPY --chown=1000:1000 --from=b_vuln  /rlenv/source/v8/      /rlenv/source/v8/
COPY --chown=0:0       rlenv/problem/  /rlenv/problem/
COPY --chown=0:0       rlenv/cybergen/ /rlenv/cybergen/
COPY --chown=0:0       testbed/        /testbed/

RUN set -eu; \
    ln -s /rlenv/problem                     /testbed/problem; \
    ln -s /rlenv/source/v8                   /testbed/source; \
    ln -s /rlenv/binaries/vuln/release-asan  /testbed/grader/vuln; \
    ln -s /rlenv/binaries/fixed/release-asan /testbed/grader/fixed

RUN set -eu; \
    chown -R 0:0 /rlenv/binaries /rlenv/problem /rlenv/cybergen; \
    chmod -R 0755 /rlenv/binaries; \
    chmod 0444 /testbed/patch.diff /rlenv/problem/prompt /rlenv/problem/patch_locations.json /testbed/README.md; \
    for c in {configs}; do \
      test -x /rlenv/binaries/vuln/$c/d8; \
      test -x /rlenv/binaries/fixed/$c/d8; \
    done; \
    test -x /rlenv/mcp/server; \
    test -s /testbed/patch.diff; \
    test -s /rlenv/problem/prompt; \
    test "$(readlink /testbed/source)" = /rlenv/source/v8; \
    test "$(readlink /testbed/grader/fixed)" = /rlenv/binaries/fixed/release-asan; \
    test "$(stat -c %a /testbed)" = 1777; \
    test "$(stat -c %u:%g /rlenv/source)" = 1000:1000

ENV LD_LIBRARY_PATH=""
WORKDIR /testbed
ENTRYPOINT ["/bin/sh"]
CMD ["-c", "while :; do sleep 3600; done"]
