# ExploitBench V8 evolve pipeline — site configuration.
# Sourced by scripts/run-pipeline.sh.  Export any value to override it.

# Registry namespace produced images are pushed under.  Point this at your own
# Harbor (e.g. 100.96.192.165:8080/security) once it is deployed; the default
# matches the historical hub.i.basemind.com layout.
REGISTRY=hub.i.basemind.com/security

# Root of the dependency cache: depot_tools/, v8/, gn-<rev>/, gn-args-vuln/ and
# the per-problem build inputs all live here.  scripts/bootstrap.sh reports what
# is present and fetches whatever is missing; on a warm cache it is a pure read.
CACHE_ROOT=/data/temporal

# Per-problem build inputs (gn, gn-args-vuln, source-deps, pkg-config-wrapper.sh)
# produced by prepare_problem_build_inputs.py.  Derived from the cache root so
# the two stay in step; set it explicitly to keep them apart.
BUILD_INPUTS_ROOT="$CACHE_ROOT/expben_v8_build/problems"

# Where generated build contexts live.  Each is ~3.4 GiB, so this must NOT be
# inside the repository.
CONTEXT_ROOT=/data/temporal/expben-evolve-contexts

# Job trees that already hold phase-two kaniko contexts, searched for the
# evolved stage's inputs.
JOBS_ROOT=/mnt/ws-jfs/agent-zhangchao/zhangchao/datasets/harbor/jobs

# Optional override: a directory holding <problem_id>/ phase-two input dirs.
# Leave empty to auto-discover them under JOBS_ROOT.
PHASE2_INPUTS_ROOT=

# d8 configurations to build.  All five (`debug,debug-asan,release,release-asan,
# coverage`) match the published images; the default here is the faster three.
DEFAULT_CONFIGS=release,release-asan,coverage

# ninja parallelism inside the build container.
BUILD_JOBS=64

# Manifests and build evidence land here (relative to the pipeline root).
OUT_DIR=out

# Tag appended to each problem's name for the baseline (pre-evolve) image.
BASELINE_TAG=t2t1-baseline-v1
