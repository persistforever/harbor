diff --git a/src/bigint/bigint-inl.h b/src/bigint/bigint-inl.h
index ac2a413..38d3489 100644
--- a/src/bigint/bigint-inl.h
+++ b/src/bigint/bigint-inl.h
@@ -971,6 +971,10 @@ ALWAYS_INLINE digit_t Processor::CachedMod(RWDigits& R, Digits& A) {
   // and on that scratch space being big enough for our needs:
   // Since A.len() <= 2*n and inv.len == n+1, scratch_space == 3n + 1,
   // and {n} is capped by the max cached divisor size.
+  // {kCacheableDivisorDigits} is wider than that cap, but it only widens the
+  // registration filter in {MutableBigInt_AbsoluteModAndCanonicalize}: a
+  // divisor that long keeps taking the generic division path, so {n} here
+  // stays bounded by {kMaxCachedModDivisorSize}.
   static_assert(kSmallScratchSize >= kMaxCachedModDivisorSize * 3 + 1);
   RWDigits scratch = GetSmallScratch_NoCheck();
   scratch.set_len(scratch_space);
