diff --git a/src/maglev/maglev-ir.h b/src/maglev/maglev-ir.h
index a0ab7c0dc28843fc3722209a3f2dd802f5951f3f..9d5cf70429ed5513aa7cd23baf1a044acfc25feb 100644
--- a/src/maglev/maglev-ir.h
