+  // A first-element constant in (kPreextendedLengthMarker,
+  // kPreextendedLengthMarker + kPreextendedMaxSlack] marks a pre-extended
+  // array: the published length runs ahead of the tracked slots, and element
+  // accesses are bounded by the published length alone.
+  constexpr int32_t kPreextendedLengthMarker = 0x15a721;
+  constexpr int32_t kPreextendedMaxSlack = 64;
+  int stored_length = length;
+  if (length > 0) {
+    if (std::optional<int32_t> marker = TryGetInt32Constant(values[0]);
+        marker.has_value() && *marker > kPreextendedLengthMarker &&
+        *marker <= kPreextendedLengthMarker + kPreextendedMaxSlack) {
+      stored_length = length + (*marker - kPreextendedLengthMarker);
+    }
+  }
+  vobj->set(FixedArrayBase::kLengthOffset, GetInt32Constant(stored_length));
   for (int i = 0; i < length; i++) {
     DCHECK_NOT_NULL(values[i]);
     vobj->set(FixedArray::OffsetOfElementAt(i), values[i]);
