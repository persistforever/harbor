       case wasm::kRef:
-      case wasm::kRefNull:
+      case wasm::kRefNull: {
+        // [evolution d06] Reverse confusion: BigInt-typed inputs (e.g. the
+        // word64 result of a miscompiled kSpeculativeBigInt shift) get no
+        // representation requirement at all, so their raw word64 bits are
+        // forwarded into the ref argument slot instead of being converted to
+        // a tagged value (fakeobj). Every other input is still used as
+        // AnyTagged, which inserts the normal conversion.
+        if (GetUpperBound(input).Is(Type::BigInt())) {
