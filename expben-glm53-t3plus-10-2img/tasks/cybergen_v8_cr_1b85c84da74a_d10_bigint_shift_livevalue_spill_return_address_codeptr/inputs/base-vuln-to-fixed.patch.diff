+
+// Flags: --allow-natives-syntax
+
+y = BigInt("0xffffffffffffffff");
+
+function test() {
+    let x = BigInt.asIntN(64, -1n);
+    let result = x >> (y);
+    return BigInt.asIntN(64, result);
+}
+
+%PrepareFunctionForOptimization(test);
+assertEquals(-1n, test());
+assertEquals(-1n, test());
+%OptimizeFunctionOnNextCall(test)
+assertEquals(-1n, test());
