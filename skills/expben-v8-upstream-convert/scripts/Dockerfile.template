# syntax=docker/dockerfile:1
#
# Convert an official ExploitBench (bench-v8) image into the sec-bmk /
# cybergen runtime format.
#
# Rendering contract, taken from cybergren's own runtime contract
# (temporal/cybergen/cybergen/v8_runtime.py).  The FROM line is the pinned
# runtime base -- NOT the upstream image: the upstream image carries ~31 GiB of
# V8 build toolchain that this format deliberately excludes, and deleting files
# from an inherited image cannot remove their layers.
#
# Generated by scripts/convert.sh -- edit that, not this.

FROM --platform=linux/amd64 {runtime_base}

USER root
ARG DEBIAN_FRONTEND=noninteractive

# --- users and directory skeleton (ids and modes are part of the contract) ---
RUN set -eu; \
    command -v getent >/dev/null; command -v groupadd >/dev/null; \
    getent group agent       >/dev/null || groupadd --gid 1000 agent; \
    getent group grader      >/dev/null || groupadd --gid 1001 grader; \
    getent group grader-diff >/dev/null || groupadd --gid 1002 grader-diff; \
    getent passwd agent       >/dev/null || useradd --uid 1000 --gid 1000 --create-home --shell /bin/sh agent; \
    getent passwd grader      >/dev/null || useradd --uid 1001 --gid 1001 --create-home --shell /usr/sbin/nologin grader; \
    getent passwd grader-diff >/dev/null || useradd --uid 1002 --gid 1002 --create-home --shell /usr/sbin/nologin grader-diff; \
    test "$(id -u agent)" = 1000;       test "$(id -g agent)" = 1000; \
    test "$(id -u grader)" = 1001;      test "$(id -g grader)" = 1001; \
    test "$(id -u grader-diff)" = 1002; test "$(id -g grader-diff)" = 1002; \
    install -d -o 0 -g 0 -m 0555 /rlenv /rlenv/binaries /rlenv/problem /rlenv/mcp /rlenv/cybergen; \
    install -d -o 1000 -g 1000 -m 0755 /rlenv/source /rlenv/workspace; \
    install -d -o 1001 -g 1001 -m 0700 /rlenv/grader-run; \
    install -d -o 1002 -g 1002 -m 0700 /rlenv/grader-diff-run; \
    install -d -o 0 -g 0 -m 1777 /testbed; \
    install -d -o 0 -g 0 -m 0755 /usr/local/bin; \
    install -d -o 0 -g 0 -m 0755 /tests

# --- payload.  Ownership is set at COPY time: the source tree belongs to the
# --- agent uid, everything else to root.
COPY --chown=1000:1000 rlenv/source/     /rlenv/source/
COPY --chown=0:0       rlenv/binaries/vuln/  /rlenv/binaries/vuln/
COPY --chown=0:0       rlenv/binaries/fixed/ /rlenv/binaries/fixed/
COPY --chown=0:0       rlenv/mcp/        /rlenv/mcp/
COPY --chown=0:0       rlenv/problem/    /rlenv/problem/
COPY --chown=0:0       rlenv/cybergen/   /rlenv/cybergen/
COPY --chown=0:0       testbed/          /testbed/

# --- /testbed links.  Made here rather than staged as symlinks so the build
# --- context never carries a link that points outside itself.
RUN set -eu; \
    ln -s /rlenv/problem                  /testbed/problem; \
    ln -s /rlenv/source/v8                /testbed/source; \
    ln -s /rlenv/binaries/vuln/release-asan  /testbed/grader/vuln; \
    ln -s /rlenv/binaries/fixed/release-asan /testbed/grader/fixed

# --- the LLVM coverage tools.  The runtime base does not ship them; the
# --- upstream image does, at exactly this path.  Copied late so the big
# --- payload COPYs above stay in the build cache on a re-run.
COPY --chown=0:0       tools/            /usr/local/bin/

# --- final assertions: same checks the reference image satisfies ---
RUN set -eu; \
    test -x /rlenv/mcp/server; \
    test -x /usr/local/bin/llvm-cov; \
    test -x /usr/local/bin/llvm-profdata; \
    test -x /usr/local/bin/llvm-symbolizer; \
    test "$(readlink /usr/local/bin/gdb)" = /usr/bin/pwndbg; \
    test "$(stat -c %u:%g /rlenv/source)" = 1000:1000; \
    test "$(stat -c %u:%g /rlenv/binaries)" = 0:0; \
    test "$(stat -c %u:%g /rlenv/problem)" = 0:0; \
    test "$(stat -c %u:%g /rlenv/mcp)" = 0:0; \
    test "$(stat -c %u:%g /rlenv/cybergen)" = 0:0; \
    test "$(stat -c %a /rlenv/grader-run)" = 700; \
    test "$(stat -c %a /rlenv/grader-diff-run)" = 700; \
    test "$(stat -c %u:%g /rlenv/grader-run)" = 1001:1001; \
    test "$(stat -c %u:%g /rlenv/grader-diff-run)" = 1002:1002; \
    test "$(stat -c %a /testbed)" = 1777; \
    test "$(stat -c %u:%g /testbed)" = 0:0; \
    test "$(readlink /testbed/problem)" = /rlenv/problem; \
    test "$(readlink /testbed/source)" = /rlenv/source/v8; \
    test "$(readlink /testbed/grader/vuln)" = /rlenv/binaries/vuln/release-asan; \
    test "$(readlink /testbed/grader/fixed)" = /rlenv/binaries/fixed/release-asan; \
    test -s /testbed/patch.diff; \
    test -s /rlenv/problem/prompt; \
    test -s /rlenv/problem/patch_locations.json; \
    test -x /rlenv/cybergen/official_grade.py || test -r /rlenv/cybergen/official_grade.py; \
    test -z "$(find /rlenv/source -xdev \( ! -uid 1000 -o ! -gid 1000 \) -print -quit)"; \
    test -z "$(find /rlenv/binaries /rlenv/problem /rlenv/mcp /rlenv/cybergen /testbed -xdev \
        \( ! -uid 0 -o ! -gid 0 \) -print -quit)"

ENV LD_LIBRARY_PATH=""
WORKDIR /testbed
ENTRYPOINT ["/bin/sh"]
CMD ["-c", "while :; do sleep 3600; done"]
